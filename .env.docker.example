# Docker Compose local development only. Never use these defaults in production.
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
AHD_HTTP_PORT=8080
AHD_ALLOWED_ORIGINS=http://localhost:8080

# Compose service discovery: Laravel uses DB_HOST=mysql inside the network.
MYSQL_DATABASE=ahd
MYSQL_USER=ahd
MYSQL_PASSWORD=ahd_local_password
MYSQL_ROOT_PASSWORD=root_local_only

# Same-origin local media URL; production may use the host's canonical URL or S3.
FILESYSTEM_PUBLIC_URL=/storage

# Local-only idempotent admin bootstrap. Change these values in your ignored .env.docker.
AHD_ADMIN_NAME=AHD Local Admin
AHD_ADMIN_EMAIL=admin@ahd.local
AHD_ADMIN_PASSWORD=change-me-local-only

# Set true if filesystem watching is unreliable in Docker Desktop/WSL2.
CHOKIDAR_USEPOLLING=false

# Optional phpMyAdmin tools profile.
PHPMYADMIN_PORT=8081
