# HISTORICAL / SUPERSEDED NODE API ENVIRONMENT
# The current backend is laravel-api (Laravel 12 + MySQL). Use laravel-api/.env.example
# for current setup and deployment. This file is retained for rollback/reference only.

# Former Express API
DATABASE_URL=postgresql://user:password@localhost:5432/ahd
PORT=3001
NODE_ENV=development
AHD_ALLOWED_ORIGINS=http://localhost:5173
AHD_ADMIN_EMAIL=admin@example.com
AHD_ADMIN_PASSWORD=replace-with-a-long-random-password

# Former S3-compatible configuration
AHD_S3_BUCKET=ahd-media
AHD_S3_REGION=us-east-1
AHD_S3_ENDPOINT=
AHD_S3_PUBLIC_BASE_URL=https://media.example.com
AHD_S3_FORCE_PATH_STYLE=false
AHD_S3_ACCESS_KEY_ID=
AHD_S3_SECRET_ACCESS_KEY=

# Preserved frontend fallback/build values
VITE_API_URL=http://localhost:3001/api/v1
BASE_PATH=/
VITE_WHATSAPP_NUMBER=
VITE_PHONE_NUMBER=
