# API
# API/database lifecycle: run `pnpm db:migrate` before production traffic.
DATABASE_URL=postgresql://user:password@localhost:5432/ahd
PORT=3001
NODE_ENV=development
# Comma-separated browser origins. Keep this explicit in production; do not use `*` with credentials.
AHD_ALLOWED_ORIGINS=http://localhost:5173

# First admin bootstrap (use a secret manager outside local development)
AHD_ADMIN_EMAIL=admin@example.com
AHD_ADMIN_PASSWORD=replace-with-a-long-random-password

# S3-compatible worker media storage
AHD_S3_BUCKET=ahd-media
AHD_S3_REGION=us-east-1
AHD_S3_ENDPOINT=
AHD_S3_PUBLIC_BASE_URL=https://media.example.com
AHD_S3_FORCE_PATH_STYLE=false
AHD_S3_ACCESS_KEY_ID=
AHD_S3_SECRET_ACCESS_KEY=

# Frontend
VITE_API_URL=http://localhost:3001/api/v1
# Required by the preserved mockup package during builds; `/` is the normal local value.
BASE_PATH=/
# These are local fallbacks only. Production WhatsApp/phone values come from system settings.
VITE_WHATSAPP_NUMBER=
VITE_PHONE_NUMBER=
